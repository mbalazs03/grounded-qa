# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://qa:qa@db:5432/qa

# Optional: a Hugging Face read token for faster model downloads
HF_TOKEN=
# Set to 1 after the embedding model has been downloaded once
HF_HUB_OFFLINE=0

# Ollama running on the host machine
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
